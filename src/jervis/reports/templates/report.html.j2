<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.titulo }} — {{ d.gerado_em | dt }}</title>
<style>
  :root {
    --ink: #1d2733; --muted: #5f6b78; --line: #dde3e9; --soft: #f5f7f9; --brand: #1f4e79;
    {% for c in d.classificacoes %}--{{ c }}: {{ d.estilos[c].color }}; --{{ c }}-bg: #{{ d.estilos[c].fill }};
    {% endfor %}
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 14px/1.45 "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: #fff; }
  .page { max-width: 1280px; margin: 0 auto; padding: 24px 16px 48px; }
  header.top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 8px;
    border-bottom: 3px solid var(--brand); padding-bottom: 12px; }
  h1 { margin: 0; font-size: 24px; color: var(--brand); }
  h2 { margin: 36px 0 12px; font-size: 19px; color: var(--brand); border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  h3 { margin: 22px 0 8px; font-size: 15px; }
  .meta { color: var(--muted); font-size: 13px; }
  nav.toc { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 12px 0 0; font-size: 13px; }
  nav.toc a { color: var(--brand); text-decoration: none; }
  nav.toc a:hover { text-decoration: underline; }

  /* Resumo executivo */
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .kpi { border: 1px solid var(--line); border-left: 5px solid var(--line); border-radius: 6px; padding: 12px 14px; background: #fff; }
  .kpi .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
  .kpi .value { font-size: 30px; font-weight: 600; line-height: 1.2; margin-top: 2px; }
  .kpi .note { color: var(--muted); font-size: 12px; }
  {% for c in d.classificacoes %}.kpi.tone-{{ c }} { border-left-color: var(--{{ c }}); background: var(--{{ c }}-bg); }
  .kpi.tone-{{ c }} .value { color: var(--{{ c }}); }
  {% endfor %}

  /* Distribuição */
  .dist { display: grid; grid-template-columns: 170px 1fr 60px; gap: 6px 12px; align-items: center; }
  .bar { display: flex; height: 18px; border-radius: 4px; overflow: hidden; background: var(--soft); }
  .bar span { display: block; height: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 10px; }

  /* Selos de classificação */
  .badge { display: inline-flex; align-items: center; gap: 5px; padding: 1px 8px 1px 5px; border-radius: 10px;
    font-size: 12px; font-weight: 600; white-space: nowrap; }
  {% for c in d.classificacoes %}.badge.{{ c }} { background: var(--{{ c }}-bg); color: #{{ d.estilos[c].font }}; }
  {% endfor %}
  .badge svg { width: 14px; height: 14px; flex: none; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; }
  .pill.sucesso { background: var(--normal-bg); color: #{{ d.estilos.normal.font }}; }
  .pill.parcial { background: var(--atencao-bg); color: #{{ d.estilos.atencao.font }}; }
  .pill.falha { background: var(--falha_coleta-bg); color: #{{ d.estilos.falha_coleta.font }}; }

  /* Tabelas */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; background: var(--soft); color: var(--muted); font-weight: 600; font-size: 12px;
    border-bottom: 1px solid var(--line); padding: 6px 8px; white-space: nowrap; }
  td { border-bottom: 1px solid var(--line); padding: 6px 8px; vertical-align: top; }
  tr.prio td:first-child { border-left: 4px solid transparent; }
  {% for c in d.classificacoes %}tr.prio.{{ c }} td:first-child { border-left-color: var(--{{ c }}); }
  {% endfor %}
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .obs { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .muted { color: var(--muted); }
  .empty { color: var(--muted); font-style: italic; padding: 8px 0; }

  /* Plataformas */
  .platform-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .platform-head h2 { flex: 1 1 auto; }
  .counts { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 4px; }

  /* Filtros (somente na tela) */
  .toolbar { position: sticky; top: 0; z-index: 2; background: #fff; border-bottom: 1px solid var(--line);
    padding: 8px 0; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .toolbar label { display: inline-flex; align-items: center; gap: 4px; cursor: pointer; font-size: 13px; }
  .toolbar input[type=search] { padding: 5px 8px; border: 1px solid var(--line); border-radius: 4px; min-width: 220px; font: inherit; }
  tr.hidden { display: none; }

  @page { size: A4 landscape; margin: 10mm; }
  @media print {
    body { font-size: 11px; }
    .page { max-width: none; padding: 0; }
    nav.toc, .toolbar { display: none; }
    h2, h3 { break-after: avoid; }
    .kpis { grid-template-columns: repeat(6, 1fr); gap: 8px; }
    .kpi { padding: 8px 10px; }
    .kpi .value { font-size: 24px; }
    .kpi, tr { break-inside: avoid; }
    .table-wrap { overflow: visible; }
    section.platform { break-before: page; }
  }
</style>
</head>
<body>
{% macro icon(c) -%}
{%- set color = d.estilos[c].color -%}
{%- if c == "critico" -%}
<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="{{ color }}"/><path d="M5 5l6 6M11 5l-6 6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
{%- elif c == "indisponivel" -%}
<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="{{ color }}"/><path d="M4 8h8" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
{%- elif c == "falha_coleta" -%}
<svg viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" rx="3" fill="{{ color }}"/><path d="M5.6 6a2.4 2.4 0 1 1 3.3 2.2c-.6.3-.9.7-.9 1.3v.5" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/><circle cx="8" cy="12.6" r="1.1" fill="#fff"/></svg>
{%- elif c == "atencao" -%}
<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1l7.5 13.5H.5z" fill="{{ color }}"/><path d="M8 6v4" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="12.3" r="1" fill="#fff"/></svg>
{%- else -%}
<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="{{ color }}"/><path d="M4.5 8.2l2.3 2.3 4.7-4.9" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endif -%}
{%- endmacro %}
{% macro badge(c, count=None) -%}
<span class="badge {{ c }}">{{ icon(c) }}{{ d.estilos[c].label }}{% if count is not none %}: {{ count }}{% endif %}</span>
{%- endmacro %}
{% macro counts(by_class) -%}
<div class="counts">{% for c, n in by_class.items() %}{{ badge(c, n) }}{% endfor %}</div>
{%- endmacro %}
{% macro records_table(rows, show_platform=True, show_category=True) -%}
<div class="table-wrap"><table class="records">
  <thead><tr>
    <th>Classificação</th>{% if show_platform %}<th>Plataforma</th>{% endif %}{% if show_category %}<th>Categoria</th>{% endif %}
    <th>Recurso</th><th>Situação / mensagem</th><th>Status na plataforma</th><th>Severidade</th><th>Data do evento</th>
  </tr></thead>
  <tbody>
  {% for r in rows %}
    <tr class="prio {{ r.classificacao }}" data-cls="{{ r.classificacao }}">
      <td>{{ badge(r.classificacao) }}</td>
      {% if show_platform %}<td>{{ r.plataforma }}</td>{% endif %}
      {% if show_category %}<td>{{ d.categorias.get(r.categoria, r.categoria) }}</td>{% endif %}
      <td><strong>{{ r.recurso or "—" }}</strong></td>
      <td>{{ r.mensagem or "—" }}{% if r.observacoes %}<div class="obs">{{ r.observacoes | join(" · ") }}</div>{% endif %}</td>
      <td>{{ r.status or "—" }}</td>
      <td>{{ r.severidade or "—" }}</td>
      <td class="muted">{{ r.data_evento | dt }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table></div>
{%- endmacro %}

<div class="page">
<header class="top">
  <div>
    <h1>{{ d.titulo }}</h1>
    <div class="meta">Gerado em {{ d.gerado_em | dt }} · {{ d.fontes | length }} plataforma(s) · {{ d.resumo.total }} registro(s)</div>
  </div>
  <div class="meta">{% for s in d.fontes %}{{ s.plataforma }}: {{ s.data_coleta | dt }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
</header>
<nav class="toc">
  <a href="#executivo">Resumo executivo</a><a href="#consolidado">Visão consolidada</a><a href="#prioridades">Prioridades</a>
  {% for p in d.plataformas %}<a href="#plataforma-{{ p.nome }}">{{ p.titulo }}{% if p.nome != p.tipo %} ({{ p.nome }}){% endif %}</a>{% endfor %}
  <a href="#qualidade">Qualidade dos dados</a>
</nav>

{% set e = d.executivo %}
<section id="executivo">
  <h2>Resumo executivo</h2>
  <div class="kpis">
    <div class="kpi">
      <div class="label">Total de dispositivos</div><div class="value">{{ e.dispositivos.total }}</div>
      <div class="note">{% for n, c in e.dispositivos.por_plataforma.items() %}{{ n }}: {{ c }}{% if not loop.last %} · {% endif %}{% else %}nenhum coletado{% endfor %}</div>
    </div>
    <div class="kpi {% if e.alertas.ativos %}tone-atencao{% endif %}">
      <div class="label">Total de alertas</div><div class="value">{{ e.alertas.total }}</div>
      <div class="note">{{ e.alertas.ativos }} ativo(s) exigindo acompanhamento</div>
    </div>
    <div class="kpi {% if e.criticos %}tone-critico{% else %}tone-normal{% endif %}">
      <div class="label">Problemas críticos</div><div class="value">{{ e.criticos }}</div>
      <div class="note">em todas as plataformas</div>
    </div>
    {% set cb = e.cobertura.backups %}
    {% if not cb.com_dados %}
    <div class="kpi {% if cb.consultadas %}tone-falha_coleta{% endif %}">
      <div class="label">Backups com falha</div><div class="value">—</div>
      <div class="note">{% if cb.consultadas %}sem dados: {{ cb.sem_resposta | join(", ") }} sem resposta{% else %}Acronis não consultada{% endif %}</div>
    </div>
    {% else %}
    <div class="kpi {% if e.backups_com_falha %}tone-critico{% elif e.backups_em_atencao %}tone-atencao{% else %}tone-normal{% endif %}">
      <div class="label">Backups com falha</div><div class="value">{{ e.backups_com_falha }}</div>
      <div class="note">{{ e.backups_em_atencao }} incompleto(s), desatualizado(s) ou com avisos{% if cb.sem_resposta %}; sem dados de {{ cb.sem_resposta | join(", ") }}{% endif %}</div>
    </div>
    {% endif %}
    {% set ch = e.cobertura.hosts %}
    {% if not ch.com_dados %}
    <div class="kpi {% if ch.consultadas %}tone-falha_coleta{% endif %}">
      <div class="label">Hosts indisponíveis</div><div class="value">—</div>
      <div class="note">{% if ch.consultadas %}sem dados: {{ ch.sem_resposta | join(", ") }} sem resposta{% else %}Zabbix não consultado{% endif %}</div>
    </div>
    {% else %}
    <div class="kpi {% if e.hosts_indisponiveis %}tone-indisponivel{% else %}tone-normal{% endif %}">
      <div class="label">Hosts indisponíveis</div><div class="value">{{ e.hosts_indisponiveis }}</div>
      <div class="note">monitorados pelo Zabbix{% if ch.sem_resposta %}; sem dados de {{ ch.sem_resposta | join(", ") }}{% endif %}</div>
    </div>
    {% endif %}
    <div class="kpi {% if e.plataformas_sem_resposta %}tone-falha_coleta{% else %}tone-normal{% endif %}">
      <div class="label">Plataformas sem resposta</div><div class="value">{{ e.plataformas_sem_resposta | length }}</div>
      <div class="note">{% if e.plataformas_sem_resposta %}{{ e.plataformas_sem_resposta | join(", ") }} — dados ausentes no relatório{% else %}de {{ e.plataformas_total }} consultada(s){% endif %}</div>
    </div>
  </div>
</section>

<section id="consolidado">
  <h2>Visão consolidada</h2>
  {% set total = d.resumo.total or 1 %}
  <div class="dist">
    {% for row_name, by_class in [("Todas as plataformas", d.resumo.por_classificacao)] + (d.resumo.por_plataforma.items() | list) %}
      {% set row_total = by_class.values() | sum %}
      <div><strong>{{ row_name }}</strong></div>
      <div class="bar" role="img" aria-label="{% for c, n in by_class.items() %}{{ d.estilos[c].label }} {{ n }}; {% endfor %}">
        {% for c, n in by_class.items() %}<span style="width: {{ (100 * n / (row_total or 1)) | round(2) }}%; background: var(--{{ c }})" title="{{ d.estilos[c].label }}: {{ n }}"></span>{% endfor %}
      </div>
      <div class="num muted">{{ row_total }}</div>
    {% endfor %}
  </div>
  <div class="legend">{% for c in d.classificacoes %}{{ badge(c, d.resumo.por_classificacao.get(c, 0)) }}{% endfor %}</div>

  <h3>Situação das plataformas</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>Plataforma</th><th>Tipo</th><th>Ambiente</th><th>Coleta</th><th>Data da coleta</th>
      {% for c in d.classificacoes %}<th class="num">{{ d.estilos[c].label }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for p in d.plataformas %}
      <tr>
        <td><a href="#plataforma-{{ p.nome }}">{{ p.nome }}</a></td><td>{{ p.titulo }}</td><td>{{ p.ambiente or "—" }}</td>
        <td><span class="pill {{ p.status_coleta }}">{{ p.status_label }}</span></td><td class="muted">{{ p.data_coleta | dt }}</td>
        {% for c in d.classificacoes %}<td class="num">{{ p.por_classificacao.get(c, 0) or "·" }}</td>{% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table></div>

  <h3>Por categoria</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>Categoria</th>{% for c in d.classificacoes %}<th class="num">{{ d.estilos[c].label }}</th>{% endfor %}<th class="num">Total</th></tr></thead>
    <tbody>
    {% for cat, by_class in d.resumo.por_categoria.items() %}
      <tr><td>{{ d.categorias.get(cat, cat) }}</td>
        {% for c in d.classificacoes %}<td class="num">{{ by_class.get(c, 0) or "·" }}</td>{% endfor %}
        <td class="num"><strong>{{ by_class.values() | sum }}</strong></td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

{% if not compact %}
<div class="toolbar" id="filtros">
  <strong>Filtrar:</strong>
  {% for c in d.classificacoes %}<label><input type="checkbox" class="cls-filter" value="{{ c }}" checked>{{ badge(c) }}</label>{% endfor %}
  <input type="search" id="busca" placeholder="Buscar recurso, mensagem..." aria-label="Buscar">
</div>
{% endif %}

<section id="prioridades">
  <h2>Prioridades <span class="meta">— itens que não estão normais, do mais urgente ao menos urgente</span></h2>
  {% if d.prioritarios %}
    {{ records_table(d.prioritarios) }}
    {% if d.prioritarios_total > d.prioritarios | length %}
      <p class="muted">Exibindo os {{ d.prioritarios | length }} primeiros de {{ d.prioritarios_total }}; a lista completa está nas seções por plataforma e no Excel.</p>
    {% endif %}
  {% else %}
    <p class="empty">Nenhum item fora do normal.</p>
  {% endif %}
</section>

{% for p in d.plataformas %}
<section class="platform" id="plataforma-{{ p.nome }}">
  <div class="platform-head">
    <h2>{{ p.titulo }}{% if p.nome != p.tipo %} — {{ p.nome }}{% endif %}</h2>
    <span class="pill {{ p.status_coleta }}">{{ p.status_label }}</span>
    <span class="meta">{{ p.ambiente }} · coletado em {{ p.data_coleta | dt }} · {{ p.total }} registro(s)</span>
  </div>
  {{ counts(p.por_classificacao) }}
  {% for cat in p.categorias %}
    <h3>{{ cat.titulo }} <span class="meta">({{ cat.registros | length }})</span></h3>
    {{ counts(cat.por_classificacao) }}
    {% if compact %}
      {% set shown = cat.registros | rejectattr("classificacao", "equalto", "normal") | list %}
      {% set hidden = cat.registros | length - shown | length %}
      {% if shown %}{{ records_table(shown, show_platform=False, show_category=False) }}{% endif %}
      {% if hidden %}<p class="muted">{{ hidden }} registro(s) normal(is) omitido(s) nesta versão impressa; consulte o HTML ou o Excel.</p>{% endif %}
    {% else %}
      {{ records_table(cat.registros, show_platform=False, show_category=False) }}
    {% endif %}
  {% else %}
    <p class="empty">Nenhum dado coletado desta plataforma.</p>
  {% endfor %}
</section>
{% endfor %}

{% set v = d.validacao %}
<section id="qualidade">
  <h2>Qualidade dos dados</h2>
  <div class="table-wrap"><table style="max-width: 560px">
    <tbody>
      <tr><td>Registros recebidos das coletas</td><td class="num">{{ v.registros_recebidos }}</td></tr>
      <tr><td>Registros consolidados</td><td class="num">{{ v.registros_consolidados }}</td></tr>
      <tr><td>Duplicidades removidas</td><td class="num">{{ v.duplicados_removidos }}</td></tr>
      <tr><td>Descartados por dados obrigatórios ausentes</td><td class="num">{{ v.descartados | length }}</td></tr>
      <tr><td>Registros com observações</td><td class="num">{{ v.com_observacoes }}</td></tr>
    </tbody>
  </table></div>
  {% if v.descartados %}
    <h3>Registros descartados</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Plataforma</th><th>Categoria</th><th>Origem</th><th>Motivo</th></tr></thead>
      <tbody>{% for x in v.descartados %}<tr><td>{{ x.plataforma }}</td><td>{{ d.categorias.get(x.categoria, x.categoria) }}</td><td>{{ x.origem }}</td><td>{{ x.motivo }}</td></tr>{% endfor %}</tbody>
    </table></div>
  {% endif %}
  {% if v.conjuntos_ignorados %}<p class="muted">Conjuntos sem regra de consolidação (não incluídos): {{ v.conjuntos_ignorados | join(", ") }}.</p>{% endif %}
</section>

<p class="meta" style="margin-top: 40px">Jervis3000 · relatório gerado automaticamente a partir das plataformas acessadas com credenciais autorizadas.</p>
</div>

{% if not compact %}
<script>
(function () {
  var boxes = document.querySelectorAll('.cls-filter');
  var search = document.getElementById('busca');
  function apply() {
    var allowed = {};
    boxes.forEach(function (b) { allowed[b.value] = b.checked; });
    var term = (search.value || '').toLowerCase();
    document.querySelectorAll('table.records tbody tr').forEach(function (tr) {
      var ok = allowed[tr.getAttribute('data-cls')] && (!term || tr.textContent.toLowerCase().indexOf(term) !== -1);
      tr.classList.toggle('hidden', !ok);
    });
  }
  boxes.forEach(function (b) { b.addEventListener('change', apply); });
  search.addEventListener('input', apply);
})();
</script>
{% endif %}
</body>
</html>
